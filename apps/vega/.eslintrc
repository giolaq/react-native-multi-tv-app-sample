{
  "extends": [
    "@react-native",
    "eslint:recommended"
  ],
  "plugins": ["@typescript-eslint"],
  "ignorePatterns": ["test/**/*.js"],
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "project": "./tsconfig.json"
      }
    }
  ]
}
