{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest", "@amazon-devices/react-native-kepler", "node"],
    "moduleSuffixes": [".vega", ".kepler", ""],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native"],
      "react-native/*": ["./node_modules/react-native/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "../../packages/shared-ui/src/types/react-native-tvos.d.ts"
  ],
  "exclude": ["node_modules", "build"]
}
